    "auth:smoke": "npm run build && node --env-file=.env.local cloud/dist/auth-smoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6",
    "@neon/realtime": "^0.1.2",
    "@neondatabase/auth": "^0.7.0-beta",
    "pg": "^8.16.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
