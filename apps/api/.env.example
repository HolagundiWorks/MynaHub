# Copy to .env (never commit it) and fill in. Every value here is a placeholder.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# The address clients use to reach this API.
PUBLIC_API_URL=https://api.company.example

# Runtime connection: the role myna_runtime (reads and writes data, cannot change the schema).
DATABASE_URL=postgresql://myna_runtime:CHANGE_ME@ep-your-endpoint.example.neon.tech/neondb?sslmode=require

# Migration connection: the schema owner. Used only by `npm run migrate`; leave it out of the running server's environment.
DIRECT_DATABASE_URL=postgresql://owner:CHANGE_ME@ep-your-endpoint.example.neon.tech/neondb?sslmode=require

LOG_LEVEL=info
