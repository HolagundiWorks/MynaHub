<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Adms.LoginWidget</RootNamespace>
    <AssemblyName>O-Studio.Launcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Adms.Desktop\Assets\myna.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Company>Human Centric Works</Company>
    <Product>Myna</Product>
    <AssemblyTitle>Myna</AssemblyTitle>
    <Description>System tray launcher: hosts the AI Core and the database service, starts the suite apps.</Description>
    <Copyright>Copyright © 2026 Human Centric Works</Copyright>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EngineProfile Condition="'$(EngineProfile)' == ''">release</EngineProfile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\Adms.Desktop\Assets\myna.ico" Link="Assets\myna.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Adms.Desktop\Assets\mark.png" Link="Assets\mark.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Adms.Desktop\Assets\mark-studio.png" Link="Assets\mark-studio.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Adms.Desktop\Assets\mark-coreop.png" Link="Assets\mark-coreop.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Adms.Desktop\Assets\mark-form.png" Link="Assets\mark-form.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Adms.Desktop\Assets\mark-draft.png" Link="Assets\mark-draft.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>
  <ItemGroup>
    <!-- moved to MynaHub; remove after the broker merge: the launcher no longer opens a company file (no AdmsSession). The reference stays only so the Rust engine DLL keeps being copied beside the launcher until the installer stops expecting it. -->
    <ProjectReference Include="..\Adms.Interop\Adms.Interop.csproj">
      <Properties>EngineProfile=$(EngineProfile)</Properties>
    </ProjectReference>
    <ProjectReference Include="..\Osas.Core\Osas.Core.csproj" />
    <ProjectReference Include="..\Adms.Cloud\Adms.Cloud.csproj" />
    <ProjectReference Include="..\..\..\O-COREOP\BBSDesktop\Office.Ai\Office.Ai.csproj" />
    <ProjectReference Include="..\..\..\o-ui\O.Ui\O.Ui.csproj" />
  </ItemGroup>
</Project>
