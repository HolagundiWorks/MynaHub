<Application
    x:Class="Adms.LoginWidget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
                <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteColors.xaml"/>
                <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteAccent.Orange.xaml"/>
                <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteLight.Orange.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteDark.Orange.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteDark.Orange.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Windows paints dialog buttons, selection bars and focus marks from the system accent; make that the suite orange. -->
            <Color x:Key="SystemAccentColor">#FF6B00</Color>
            <Color x:Key="SystemAccentColorLight1">#FF8A33</Color>
            <Color x:Key="SystemAccentColorLight2">#FFA866</Color>
            <Color x:Key="SystemAccentColorLight3">#FFC599</Color>
            <Color x:Key="SystemAccentColorDark1">#E65F00</Color>
            <Color x:Key="SystemAccentColorDark2">#B34A00</Color>
            <Color x:Key="SystemAccentColorDark3">#803500</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
