<Application
    x:Class="Adms.LoginWidget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
                <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteColors.xaml"/>
                <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteAccent.Orange.xaml"/>
                <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteLight.Orange.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteDark.Orange.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteDark.Orange.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Windows paints dialog buttons, selection bars and focus marks from the system accent; make that the suite Ember. -->
            <Color x:Key="SystemAccentColor">#B83E16</Color>
            <Color x:Key="SystemAccentColorLight1">#CC5A32</Color>
            <Color x:Key="SystemAccentColorLight2">#DC8062</Color>
            <Color x:Key="SystemAccentColorLight3">#EBB09B</Color>
            <Color x:Key="SystemAccentColorDark1">#A03212</Color>
            <Color x:Key="SystemAccentColorDark2">#8C2A10</Color>
            <Color x:Key="SystemAccentColorDark3">#6A200C</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
