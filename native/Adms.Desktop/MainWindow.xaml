<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Adms.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="O-Studio">
    <Grid x:Name="Root" Language="en-IN" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="DismissNotice"/>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewCommand"/>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveCommand"/>
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="PrintCommand"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindCommand"/>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="GoToCommand"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <MenuBar VerticalAlignment="Center" Background="{ThemeResource SidebarBackgroundBrush}" FontSize="13"
                 AutomationProperties.Name="Menu bar"
                 AutomationProperties.LandmarkType="Navigation">
            <MenuBarItem Title="File" AccessKey="F">
                <MenuFlyoutItem x:Name="ChooseItem" Text="Choose the company in OSAS" AccessKey="O" Click="OpenOsas"/>
                <MenuFlyoutItem x:Name="CloseItem" Text="Close company" AccessKey="C" Click="CloseCompany">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="LockItem" Text="Lock" Click="LockSession"/>
                <MenuFlyoutItem x:Name="LogoutItem" Text="Log out" Click="LogOut"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" AccessKey="X" Click="ExitApplication"/>
            </MenuBarItem>
            <MenuBarItem Title="Edit" AccessKey="E">
                <MenuFlyoutItem Text="New record" Click="NewRecord">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save" Click="SaveRecord">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="View" AccessKey="V">
                <MenuFlyoutItem Text="Pulse" Click="GoDashboard"/>
            </MenuBarItem>
            <MenuBarItem Title="Company" AccessKey="M">
                <MenuFlyoutItem Text="Company profile" Click="GoCompany"/>
            </MenuBarItem>
            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem x:Name="PreviewItem" Text="Sample letterhead PDF" Click="GeneratePreview"/>
                <MenuFlyoutItem Text="About" Click="ShowAbout"/>
            </MenuBarItem>
        </MenuBar>

        <InfoBar x:Name="Notice" Grid.Row="1" Margin="20,8,20,0" IsOpen="False" IsClosable="True" Severity="Error"
                 AutomationProperties.LiveSetting="Assertive"/>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="WelcomePanel" Padding="32">
                <Border Style="{StaticResource SetupCardStyle}" MaxWidth="560">
                    <StackPanel Spacing="12">
                        <Image x:Name="WelcomeLogo" MaxWidth="460" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="O-Studio"/>
                        <TextBlock Text="The company is chosen in OSAS, the suite app. Choose or create it there, then open O-Studio from OSAS and it opens already signed in." TextWrapping="WrapWholeWords" Style="{ThemeResource BodyStyle}"/>
                        <TextBlock Text="Developed by Human Centric Works" Style="{ThemeResource CaptionStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenOsasButton" Content="Open OSAS" Click="OpenOsas" Style="{StaticResource AccentButtonStyle}"/>
                            <Button x:Name="FollowButton" Content="Open the company OSAS chose" Click="FollowSuite" Visibility="Collapsed"/>
                        </StackPanel>
                        <InfoBar x:Name="LegacyNotice" IsOpen="False" IsClosable="False" Severity="Informational"
                                 Title="Data from the earlier version was found on this computer."
                                 Message="Convert it into a company file. The original is left untouched.">
                            <InfoBar.ActionButton>
                                <Button Content="Convert" Click="ConvertLegacy"/>
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <ScrollViewer x:Name="LoginPanel" Visibility="Collapsed" Padding="32">
                <Border Style="{StaticResource SetupCardStyle}">
                    <StackPanel Spacing="12">
                        <Image x:Name="LoginLogo" Width="56" Height="56" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="O-Studio"/>
                        <TextBlock x:Name="LoginHeading" Style="{ThemeResource PageTitleStyle}" TextWrapping="WrapWholeWords"/>
                        <TextBlock Text="Enter your username and password." Style="{ThemeResource BodyStyle}" TextWrapping="WrapWholeWords"/>
                        <TextBox x:Name="UsernameBox" Header="Username"/>
                        <PasswordBox x:Name="PasswordBox" Header="Password" KeyDown="PasswordKeyDown"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SignInButton" Content="Sign in" Click="SignIn" Style="{StaticResource AccentButtonStyle}"/>
                            <Button x:Name="SwitchFromLogin" Content="Close company" Click="CloseCompany"/>
                        </StackPanel>
                        <Button x:Name="ForgotButton" Content="Forgot password? Use recovery code" Click="ShowRecover"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <ScrollViewer x:Name="SetupPanel" Visibility="Collapsed" Padding="32">
                <Border Style="{StaticResource SetupCardStyle}">
                    <StackPanel Spacing="12">
                        <Image x:Name="SetupLogo" Width="56" Height="56" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="O-Studio"/>
                        <TextBlock x:Name="SetupHeading" Style="{ThemeResource PageTitleStyle}" Text="Set up the admin password" TextWrapping="WrapWholeWords"/>
                        <TextBlock Text="This company is opened with the admin password. The recovery code is shown once." TextWrapping="WrapWholeWords" Style="{ThemeResource BodyStyle}"/>
                        <TextBox x:Name="SetupUser" Header="Username" Visibility="Collapsed"/>
                        <PasswordBox x:Name="SetupPassword" Header="Password (12 or more characters)"/>
                        <PasswordBox x:Name="SetupConfirm" Header="Confirm password" KeyDown="SetupKeyDown"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SetupButton" Content="Create account" Click="CreateOwner" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Switch company" Click="CloseCompany"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <ScrollViewer x:Name="RecoverPanel" Visibility="Collapsed" Padding="32">
                <Border Style="{StaticResource SetupCardStyle}">
                    <StackPanel Spacing="12">
                        <Image x:Name="RecoverLogo" Width="56" Height="56" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="O-Studio"/>
                        <TextBlock Style="{ThemeResource PageTitleStyle}" Text="Reset password" TextWrapping="WrapWholeWords"/>
                        <TextBlock Text="Enter the username and the recovery code. The old recovery code stops working. A new one is shown once." TextWrapping="WrapWholeWords" Style="{ThemeResource BodyStyle}"/>
                        <TextBox x:Name="RecoverUser" Header="Username"/>
                        <TextBox x:Name="RecoverCode" Header="Recovery code"/>
                        <PasswordBox x:Name="RecoverPassword" Header="New password (12 or more characters)"/>
                        <PasswordBox x:Name="RecoverConfirm" Header="Confirm new password" KeyDown="RecoverKeyDown"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RecoverButton" Content="Reset password" Click="ResetPassword" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Back to sign in" Click="BackToSignIn"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <ScrollViewer x:Name="UnlockPanel" Visibility="Collapsed" Padding="32">
                <Border Style="{StaticResource SetupCardStyle}">
                    <StackPanel Spacing="12">
                        <Image x:Name="UnlockLogo" Width="56" Height="56" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="O-Studio"/>
                        <TextBlock x:Name="UnlockHeading" Style="{ThemeResource PageTitleStyle}" Text="Session locked" TextWrapping="WrapWholeWords"/>
                        <PasswordBox x:Name="UnlockPassword" Header="Password" KeyDown="UnlockKeyDown"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="UnlockButton" Content="Unlock" Click="Unlock" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Switch company" Click="CloseCompany"/>
                        </StackPanel>
                        <Button Content="Use recovery code" Click="ShowRecover"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Grid x:Name="WorkspaceHost" Visibility="Collapsed"/>
            <Grid x:Name="PdfHost" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"/>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource SidebarBackgroundBrush}"
                AutomationProperties.Name="Status"
                AutomationProperties.LandmarkType="Custom">
        <Grid Padding="20,6,20,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Style="{ThemeResource CaptionStyle}"
                       AutomationProperties.Name="Status message"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{ThemeResource CaptionStyle}" Text="Human Centric Works"/>
        </Grid>
        </Border>
    </Grid>
</Window>
