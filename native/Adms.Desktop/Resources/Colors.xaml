<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#F5F5F2</Color>
            <Color x:Key="SidebarBackgroundColor">#F5F5F2</Color>
            <Color x:Key="SurfaceBackgroundColor">#FFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#25282B</Color>
            <Color x:Key="TextSecondaryColor">#4E555A</Color>
            <Color x:Key="BrandAccentColor">#647B62</Color>
            <Color x:Key="BrandAccentAccessibleColor">#3E5240</Color>
            <Color x:Key="BorderSubtleColor">#D5D6D0</Color>
            <Color x:Key="BorderStrongColor">#8E928A</Color>
            <Color x:Key="FocusIndicatorColor">#3E5240</Color>
            <Color x:Key="EmphasisFillColor">#647B62</Color>
            <Color x:Key="EmphasisHoverColor">#556852</Color>
            <Color x:Key="EmphasisPressedColor">#465744</Color>
            <Color x:Key="TextOnEmphasisColor">#FFFFFF</Color>
            <Color x:Key="SelectedFillColor">#647B62</Color>
            <Color x:Key="HoverFillColor">#E8E8E3</Color>
            <Color x:Key="TextDisabledColor">#8E928A</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
            <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackgroundColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}"/>
            <SolidColorBrush x:Key="BrandAccentAccessibleBrush" Color="{StaticResource BrandAccentAccessibleColor}"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
            <SolidColorBrush x:Key="FocusIndicatorBrush" Color="{StaticResource FocusIndicatorColor}"/>
            <SolidColorBrush x:Key="EmphasisFillBrush" Color="{StaticResource EmphasisFillColor}"/>
            <SolidColorBrush x:Key="TextOnEmphasisBrush" Color="{StaticResource TextOnEmphasisColor}"/>
            <SolidColorBrush x:Key="SelectedFillBrush" Color="{StaticResource SelectedFillColor}"/>

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource AppBackgroundColor}"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource AppBackgroundColor}"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource SurfaceBackgroundColor}"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource HoverFillColor}"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource AppBackgroundColor}"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource SurfaceBackgroundColor}"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource BorderSubtleColor}"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource SurfaceBackgroundColor}"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource HoverFillColor}"/>
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource HoverFillColor}"/>
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource HoverFillColor}"/>
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource SurfaceBackgroundColor}"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource BorderStrongColor}"/>
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource BorderSubtleColor}"/>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource BorderSubtleColor}"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
            <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="{StaticResource TextOnEmphasisColor}"/>
            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource FocusIndicatorColor}"/>
            <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="{StaticResource SurfaceBackgroundColor}"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource EmphasisFillColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource EmphasisHoverColor}"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource EmphasisPressedColor}"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource TextOnEmphasisColor}"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource TextOnEmphasisColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource BrandAccentAccessibleColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource BrandAccentAccessibleColor}"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource SidebarBackgroundColor}"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource SidebarBackgroundColor}"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource AppBackgroundColor}"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource SelectedFillColor}"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource TextOnEmphasisColor}"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{StaticResource TextOnEmphasisColor}"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{StaticResource TextOnEmphasisColor}"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource SelectedFillColor}"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{StaticResource EmphasisHoverColor}"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{StaticResource EmphasisPressedColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource SelectedFillColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource EmphasisHoverColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource EmphasisPressedColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource HoverFillColor}"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{StaticResource TextOnEmphasisColor}"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="{StaticResource TextOnEmphasisColor}"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="{StaticResource TextOnEmphasisColor}"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BrandAccentAccessibleBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="FocusIndicatorBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EmphasisFillBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="TextOnEmphasisBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="SelectedFillBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
