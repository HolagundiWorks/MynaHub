<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Adms.Desktop</RootNamespace>
    <AssemblyName>O-Studio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Company>Human Centric Works</Company>
    <Product>MynaHub</Product>
    <AssemblyTitle>MynaHub</AssemblyTitle>
    <Description>MynaHub: the suite hub (company sign-in, estimates, bills, approvals)</Description>
    <Copyright>Copyright © 2026 Human Centric Works</Copyright>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\mark.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\mark.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\wordmark.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\mark-*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Adms.Cloud\Adms.Cloud.csproj" />
    <ProjectReference Include="..\Adms.Interop\Adms.Interop.csproj" />
    <ProjectReference Include="..\Osas.Core\Osas.Core.csproj" />
    <ProjectReference Include="..\..\..\MynaUI\O.Ui\O.Ui.csproj" />
  </ItemGroup>
</Project>
