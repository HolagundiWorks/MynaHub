<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Adms.Desktop</RootNamespace>
    <AssemblyName>O-Studio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Company>Human Centric Works</Company>
    <Product>O-Studio</Product>
    <AssemblyTitle>O-Studio</AssemblyTitle>
    <Description>O-Studio</Description>
    <Copyright>Copyright © 2026 Human Centric Works</Copyright>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\mark.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\wordmark.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\mark-*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <!-- The suite pages (company, users, monitor, assistant) use office.dll, the shared company-file engine, built from office-ffi.
       It ships beside the app with the accounting engine; set OfficeDll to use a build from another folder. -->
  <PropertyGroup>
    <OfficeDll Condition="'$(OfficeDll)' == ''">$(MSBuildThisFileDirectory)..\..\office-ffi\target\release\office.dll</OfficeDll>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(OfficeDll)" Link="office.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(OfficeDll)')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Adms.Interop\Adms.Interop.csproj" />
    <ProjectReference Include="..\Osas.Core\Osas.Core.csproj" />
    <ProjectReference Include="..\..\..\o-ui\Hcw.Ui\Hcw.Ui.csproj" />
  </ItemGroup>
</Project>
