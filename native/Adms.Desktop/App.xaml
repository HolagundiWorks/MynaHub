<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Adms.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <Thickness x:Key="PageMargin">16,12,16,16</Thickness>
            <x:Double x:Key="Space8">8</x:Double>
            <x:Double x:Key="Space12">12</x:Double>
            <x:Double x:Key="Space16">16</x:Double>
            <x:Double x:Key="Space20">20</x:Double>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,8,0,0"/>
            </Style>
            <Style x:Key="BodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="SecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
            </Style>
            <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="TableHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
            </Style>
            <Style x:Key="TableCellStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="SetupCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="MaxWidth" Value="440"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="ErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
