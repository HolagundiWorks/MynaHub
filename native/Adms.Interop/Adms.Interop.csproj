<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Adms.Interop</RootNamespace>
    <!-- Which build of the Rust engine to ship beside the app: the debug build while developing, release for an installer
         (build the engine in release mode, then publish with the property EngineProfile set to release). -->
    <EngineProfile Condition="'$(EngineProfile)' == ''">debug</EngineProfile>
    <EngineDll>$(MSBuildThisFileDirectory)..\..\src-tauri\target\$(EngineProfile)\architect_office_desktop_lib.dll</EngineDll>
  </PropertyGroup>
  <!-- When CARGO_TARGET_DIR is set globally, Rust output may not live under src-tauri/target. -->
  <Target Name="ResolveEngineDll" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <CargoTargetDir>$([System.Environment]::GetEnvironmentVariable('CARGO_TARGET_DIR'))</CargoTargetDir>
    </PropertyGroup>
    <PropertyGroup Condition="!Exists('$(EngineDll)') and '$(CargoTargetDir)' != ''">
      <EngineDll Condition="Exists('$(CargoTargetDir)\$(EngineProfile)\architect_office_desktop_lib.dll')">$(CargoTargetDir)\$(EngineProfile)\architect_office_desktop_lib.dll</EngineDll>
      <EngineDll Condition="!Exists('$(EngineDll)') and Exists('$(CargoTargetDir)\release\architect_office_desktop_lib.dll')">$(CargoTargetDir)\release\architect_office_desktop_lib.dll</EngineDll>
      <EngineDll Condition="!Exists('$(EngineDll)') and Exists('$(CargoTargetDir)\debug\architect_office_desktop_lib.dll')">$(CargoTargetDir)\debug\architect_office_desktop_lib.dll</EngineDll>
    </PropertyGroup>
    <PropertyGroup Condition="!Exists('$(EngineDll)')">
      <EngineDll Condition="Exists('$(MSBuildThisFileDirectory)..\..\src-tauri\target\release\architect_office_desktop_lib.dll')">$(MSBuildThisFileDirectory)..\..\src-tauri\target\release\architect_office_desktop_lib.dll</EngineDll>
    </PropertyGroup>
    <Warning Text="architect_office_desktop_lib.dll was not found (EngineDll=$(EngineDll)). Build the Rust engine: cd src-tauri &amp;&amp; cargo build --release, or pass -p:EngineDll=..." Condition="!Exists('$(EngineDll)')" />
  </Target>
  <Target Name="IncludeEngineDll" AfterTargets="ResolveEngineDll" BeforeTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup Condition="Exists('$(EngineDll)')">
      <Content Include="$(EngineDll)"
                Link="architect_office_desktop_lib.dll"
                CopyToOutputDirectory="PreserveNewest"
                Visible="false" />
    </ItemGroup>
  </Target>
</Project>
