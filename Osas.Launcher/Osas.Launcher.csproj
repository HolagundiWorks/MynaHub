<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Osas.Launcher</RootNamespace>
    <AssemblyName>OSAS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Company>Human Centric Works</Company>
    <Product>OSAS</Product>
    <AssemblyTitle>OSAS, the Open Source Architecture Suit</AssemblyTitle>
    <Description>Opens O-Studio, O-CoreOp and O-Draft</Description>
    <Copyright>Copyright © 2026 Human Centric Works</Copyright>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <!-- The office engine (office.dll) is built from the O-Studio repository: build office-ffi there in release mode. OSAS needs it to sign in
       and to show the company details; without it the Company section says so. Set OfficeDllDir to use a build from another folder. -->
  <PropertyGroup>
    <OfficeDllDir Condition="'$(OfficeDllDir)' == ''">$(MSBuildThisFileDirectory)..\..\architect-office-desktop\office-ffi\target\release</OfficeDllDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(OfficeDllDir)\office.dll" Condition="Exists('$(OfficeDllDir)\office.dll')" Link="office.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Programs OSAS starts or hands to other programs, bundled when found in ToolsDir (default: the engine's folder):
       shilpid and shilpi-http (ShilpiDB, from the shilpidb repository) go in a shilpidb folder; office-mcp (the tool server for outside
       assistants) goes beside OSAS. Without them the ShilpiDB and outside-assistant sections say they were not found. -->
  <PropertyGroup>
    <ToolsDir Condition="'$(ToolsDir)' == ''">$(OfficeDllDir)</ToolsDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(ToolsDir)\shilpid.exe" Condition="Exists('$(ToolsDir)\shilpid.exe')" Link="shilpidb\shilpid.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ToolsDir)\shilpi-http.exe" Condition="Exists('$(ToolsDir)\shilpi-http.exe')" Link="shilpidb\shilpi-http.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ToolsDir)\office-mcp.exe" Condition="Exists('$(ToolsDir)\office-mcp.exe')" Link="office-mcp.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Osas.Core\Osas.Core.csproj" />
    <ProjectReference Include="..\..\hcw-ui\Hcw.Ui\Hcw.Ui.csproj" />
  </ItemGroup>
</Project>
